# ---------------------------------------------------------------
# TOEFL 2026 Trainer — local configuration (copy to .env)
# Every provider below is OPTIONAL. Without them the app still runs
# all objective tasks; productive tasks are saved but not AI-scored.
# Keys are only read by the local server — never sent to the browser.
# ---------------------------------------------------------------

# Local API port (the web UI is served on the same port by `npm start`)
PORT=8787
# SQLite file and audio storage directory
DATA_DIR=./data

# --- LLM evaluator (Writing: Email / Academic Discussion; Speaking: Interview)
# Provider: "anthropic" or "none"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Effort for evaluation calls: low | medium | high
LLM_EFFORT=medium
LLM_TIMEOUT_MS=120000
# Language of explanations in AI feedback: en | fr
FEEDBACK_LANGUAGE=en

# --- Speech-to-text (Listen and Repeat + Interview transcripts)
# Provider: "openai" (OpenAI-compatible /v1/audio/transcriptions endpoint) or "none".
# Works with OpenAI or any compatible local server (e.g. a faster-whisper server).
STT_PROVIDER=none
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# --- Text-to-speech (listening stimuli, repeat sentences, interview questions)
# Provider: "openai" (OpenAI-compatible /v1/audio/speech endpoint) or "none".
# With "none", the browser's built-in speech synthesis is used (clearly labelled
# in the UI as a fallback — it is NOT a reproduction of ETS audio).
TTS_PROVIDER=none
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
# Comma-separated voice list; speakers are mapped onto voices deterministically
TTS_VOICES=alloy,onyx,nova,echo,shimmer,fable
