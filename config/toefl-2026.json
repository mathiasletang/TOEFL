      "correction": {
        "writing": {
          "kind": "rewrite",
          "label": "Rewrite",
          "instruction": "Rewrite each response with errors: the whole email or post from the feedback and the model answer, or each missed sentence in full. Then compare the two versions line by line."
        },
        "speaking": {
          "kind": "rerecord",
          "label": "Re-record",
          "instruction": "Listen to your recordings, then re-record your two weakest answers (or every sentence where you dropped words). Keep the better take and note what changed."
        },
        "reading_listening": {
          "kind": "review",
          "label": "Review",
          "instruction": "Redo every missed question without the clock, then write one line on why the key is right and why your choice was wrong."
        },
        "focus": {
          "kind": "review",
          "label": "Review",
          "instruction": "Redo the missed items of each drill and write the rule or pattern behind each mistake in one line."
        }
      },
