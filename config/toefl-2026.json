    "listen_repeat_proxy": {
      "$comment": "Internal thresholds from the PRD, to be calibrated on your own recordings.",
      "score_5_max_wer": 0.03,
      "score_4_max_wer": 0.12,
      "score_3_min_content_recall": 0.6,
      "score_2_min_content_recall": 0.3,
