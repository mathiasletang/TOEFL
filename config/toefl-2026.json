          "to_days": 55,
          "goal": "Measure every task once and build the error profile."
        },
        {
          "id": "foundations",
          "label": "Foundations",
          "from_days": 54,
          "to_days": 34,
          "goal": "Untimed accuracy work on the weakest patterns."
