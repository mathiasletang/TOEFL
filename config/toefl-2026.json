        "new_per_day_options": [0, 5, 10, 15, 20, 30, 40],
        "initial_ease": 2.5,
        "minimum_ease": 1.3,
        "first_interval_days": 1,
        "second_interval_days": 6,
        "relearn_minutes": 10,
        "mature_interval_days": 21,
        "fast_answer_ms": { "choice": 6000, "typed": 12000 },
        "production_share_min": 0.6,
        "leech_lapses": 4,
        "retention_window_days": 30,
        "challenge_words": 3,
        "challenge_seconds": 45
