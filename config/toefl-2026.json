      "weights": { "wer": 0.45, "content_recall": 0.2, "function_recall": 0.1, "order": 0.1, "intelligibility": 0.15 }
    },
    "recommendation_weights": { "error_frequency": 0.4, "recency": 0.25, "band_impact": 0.2, "speed_deficit": 0.15 },
    "ready_gate": {
      "$comment": "Scaled for a Band 6.0 (C2) target. All values are internal.",
      "last_full_simulations": 3,
      "minimum_projected_overall": 6.0,
      "minimum_projected_section": 5.5,
      "router_training_accuracy": { "reading": 0.9, "listening": 0.9 },
      "email_median_rubric": 4.5,
      "discussion_median_rubric": 4.5,
      "repeat_median_rubric": 4.5,
      "interview_median_rubric": 4.5,
      "max_timing_violations_last_7_days": 0
    },
    "vocabulary": {
      "$comment": "Internal conventions of the vocabulary bank (content/vocab). Nothing here is an ETS list; CEFR levels are author estimates.",
      "tiers": {
        "core": { "label": "Essentials", "cefr": ["B2", "C1"], "note": "Internal high-yield selection: cross-disciplinary academic words, campus and daily-life vocabulary, and the connectors and formulas needed for Email, Academic Discussion and Interview. Not an official list." },
        "extended": { "label": "Extended (C1)", "cefr": ["B2", "C1"], "note": "C1-level vocabulary by discipline and function; common discipline words that are really B2 are kept here and labelled B2." },
        "mastery": { "label": "Mastery (C2)", "cefr": ["C2"], "note": "C2-level vocabulary: nuance, precision and formal register." }
      },
      "targets": { "tier": { "core": 400, "extended": 467, "mastery": 462 }, "cefr_share": { "B2": 0.24, "C1": 0.41, "C2": 0.35 }, "share_tolerance": 0.05 },
      "discipline_categories": ["biology", "ecology", "geology", "astronomy", "psychology", "sociology", "anthropology", "economics", "history", "art_history", "linguistics", "environmental_science", "technology"],
      "transparency": {
        "$comment": "transparent_fr = best string similarity (0-1) between a headword and one of its French translations, after accents, articles and regular spelling correspondences are removed. Only single words count as transparent; false friends never do. A transparent discipline term cannot be C2.",
        "threshold": 0.7
      },
      "introduction": {
        "$comment": "Order in which bank entries are introduced as new cards, by profile target (the first rule whose min_target is reached applies). Groups come first, in order; then the rest by rest_cefr_order. Transparent entries always come last. Excluded categories never enter by introduction, only through automatic harvest or a manual add.",
        "rules": [
          {
            "min_target": 6.0,
            "groups": [
              { "category": "functional_language" },
              { "category": "academic_collocations" },
              { "category": "phrasal_verbs_idioms" },
              { "category": "false_friends_fr" },
              { "category": "general_academic", "cefr": ["C1", "C2"] }
            ],
            "group_cefr_order": ["C1", "C2", "B2"],
            "rest_cefr_order": ["C1", "C2", "B2"],
            "exclude_categories": ["biology", "ecology", "geology", "astronomy", "psychology", "sociology", "anthropology", "economics", "history", "art_history", "linguistics", "environmental_science", "technology"]
          },
          {
            "min_target": 0,
            "groups": [{ "tier": "core" }],
            "group_cefr_order": ["B2", "C1"],
            "rest_cefr_order": ["B2", "C1", "C2"],
            "exclude_categories": []
          }
        ]
      },
      "productive": {
        "$comment": "First batch of productive C2 entries (mastery tier). Each needs one sub-theme tag, an Interview answer, an Academic Discussion sentence and a usage note. Counts are the planned size of each sub-theme.",
        "batch": "c2_productive_1",
        "themes": { "argument_verbs": 60, "hedging_stance": 40, "concession_contrast": 35, "emphasis": 30, "precise_collocations": 80, "spoken_markers": 55 }
      },
      "harvest": {
        "$comment": "When questions are missed in an academic passage or a listening set, up to this many discipline terms of that text enter the deck (non-transparent and higher levels first). This is the only automatic way discipline terms enter for a 6.0 target.",
        "discipline_terms_per_text": 3
      },
      "triage": {
        "$comment": "Triage mode: J = known (never introduced as a new card), K = to learn. One known card in verify_every is checked later in a production format; a failed check turns it into a normal card.",
        "verify_every": 10,
        "verify_formats": ["recall_typed", "cloze_typed"],
        "verify_after_days": 7,
        "batch_size": 30
      },
      "srs": {
        "$comment": "SM-2-style scheduler. Every value is an internal training parameter.",
        "new_per_day_default": 25,
        "new_per_day_options": [0, 5, 10, 15, 20, 25, 30, 35, 40],
        "initial_ease": 2.5,
        "minimum_ease": 1.3,
        "first_interval_days": 1,
        "second_interval_days": 6,
        "relearn_minutes": 10,
        "mature_interval_days": 21,
        "fast_answer_ms": { "choice": 6000, "typed": 12000 },
        "production_share_min": 0.6,
        "leech_lapses": 4,
        "retention_window_days": 30,
        "challenge_words": 3,
        "challenge_seconds": 45
      }
    }
  }
