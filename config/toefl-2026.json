    "projection": {
      "$comment": "Heuristic mapping from training evidence to an internal band. NOT an ETS conversion table.",
      "rl_theta_cutpoints": [
        { "theta": 2.0, "band": 6.0 },
        { "theta": 1.5, "band": 5.5 },
        { "theta": 1.0, "band": 5.0 },
        { "theta": 0.5, "band": 4.5 },
        { "theta": 0.0, "band": 4.0 },
        { "theta": -0.5, "band": 3.5 },
